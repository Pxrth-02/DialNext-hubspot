# ==============================================================================
# DialNext HubSpot - Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env in local development. Never commit actual .env files!
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dialnext_hubspot?schema=public

# Queue & Cache Configuration (Redis-compatible, e.g. Render Key Value)
# Format: redis://[:PASSWORD@]HOST:PORT
REDIS_URL=redis://localhost:6379

# HubSpot OAuth App Credentials (from HubSpot Developer Portal)
HUBSPOT_CLIENT_ID=your_hubspot_client_id_here
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret_here
HUBSPOT_REDIRECT_URI=http://localhost:5000/api/oauth/callback
HUBSPOT_SCOPES=crm.objects.contacts.read crm.objects.contacts.write crm.schemas.contacts.read

# Security: Server-side Token Encryption Key (32 bytes hex or base64 for AES-256-GCM)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Frontend Public Variables (used in frontend/)
VITE_API_BASE_URL=http://localhost:5000/api
