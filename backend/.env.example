PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Queue (to be configured in subsequent phases)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dialnext_hubspot?schema=public
REDIS_URL=redis://localhost:6379

# HubSpot App (to be configured in Phase 4)
HUBSPOT_CLIENT_ID=placeholder_hubspot_client_id
HUBSPOT_CLIENT_SECRET=placeholder_hubspot_client_secret
HUBSPOT_REDIRECT_URI=http://localhost:5000/api/oauth/callback
HUBSPOT_SCOPES=crm.objects.contacts.read crm.objects.contacts.write crm.schemas.contacts.read

# Token Encryption
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
